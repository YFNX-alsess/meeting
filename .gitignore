# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---- 环境变量与密钥（务必不要提交） ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
htmlcov/
.coverage

# ---- 运行时产物 ----
runs/
.ultralytics/
Ultralytics/
torchinductor_*/
*.log
tmp/
temp/

# ---- 模型权重（体积大，不入库） ----
*.pt
*.cache

# ---- 数据集：只保留 yaml 说明，图片与标注不入库 ----
datasets/**/images/
datasets/**/*.txt
*.jpg

# ---- 前端构建产物 ----
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ---- 例外：工程日志里的截图需要入库 ----
!daily/photo/*.png
