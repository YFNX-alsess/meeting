# 环境变量模板：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# PowerShell: Copy-Item .env.example .env     CMD: copy .env.example .env

# ---- Dify 对话（只用图片识别功能时可以留空，接口会返回 503 并说明原因） ----
DIFY_API_KEY=
DIFY_BASE_URL=http://localhost/v1
# DIFY_USER=web-user-001
# DIFY_TIMEOUT=120
# 默认不走系统代理；确实需要经代理访问远程 Dify 时设为 1
# DIFY_TRUST_ENV=1

# ---- YOLO 权重（留空则自动按 runs/ 内的 best.pt -> yolov8n.pt 顺序查找） ----
# YOLO_MODEL_PATH=yolov8n.pt

# ---- 其它可选配置 ----
# MAX_UPLOAD_MB=10
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
